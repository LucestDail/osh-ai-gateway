[Unit]
Description=OSH AI Gateway — Gemini/Vertex passthrough
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seunghyun
Group=seunghyun
WorkingDirectory=/home/seunghyun/osh-ai-gateway
EnvironmentFile=/home/seunghyun/osh-ai-gateway/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/seunghyun/osh-ai-gateway/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8780 --workers 1 --proxy-headers --forwarded-allow-ips='*' --timeout-keep-alive 75 --backlog 2048
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
