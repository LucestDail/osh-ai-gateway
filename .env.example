# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8780
DEBUG=false

# LAN internal auth (recommended). Empty = disabled.
GATEWAY_INTERNAL_TOKEN=change-me-homelab-token

# Gemini AI Studio
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Vertex AI passthrough
VERTEX_ENABLED=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-northeast1
VERTEX_CREDENTIALS_PATH=/run/secrets/vertex-sa.json

# Proxy
PROXY_TIMEOUT_SECONDS=120
PROXY_STREAM_TIMEOUT_SECONDS=600

# Optional JSON lines mirror. Empty = disabled.
USAGE_LOG_PATH=

# SQLite dashboard store (required for /stats)
USAGE_DB_PATH=data/usage.db

# Cost estimate on /stats (default: gemini-2.5-flash-lite)
GEMINI_PRICE_PER_M_IN_USD=0.10
GEMINI_PRICE_PER_M_OUT_USD=0.40
USD_KRW_RATE=1380
